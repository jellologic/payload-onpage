{
  "name": "@payload-onpage/plugin",
  "version": "0.3.3",
  "description": "payload-onpage for Payload CMS: on-page editing endpoints, auto-mapping, preview links and admin controls.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-onpage.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/jellologic/payload-onpage#readme",
  "bugs": "https://github.com/jellologic/payload-onpage/issues",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "payload-plugin",
    "nextjs",
    "next.js",
    "app-router",
    "tanstack",
    "tanstack-start",
    "typescript",
    "visual-editing",
    "visual-editor",
    "inline-editing",
    "front-end-editing",
    "live-preview",
    "draft-preview",
    "preview-links",
    "page-builder",
    "wysiwyg",
    "headless-cms",
    "cms",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "bun test src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@payload-onpage/core": "workspace:*"
  },
  "peerDependencies": {
    "payload": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@payloadcms/translations": "^3.90.2",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
