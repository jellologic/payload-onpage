{
  "name": "@payload-onpage/core",
  "version": "0.1.0",
  "description": "payload-onpage core: document refs, schema, field operations, stega codec, autosave and the editor session, plus the port interfaces adapters implement.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-onpage.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jellologic/payload-onpage#readme",
  "bugs": "https://github.com/jellologic/payload-onpage/issues",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "nextjs",
    "visual-editing",
    "live-preview",
    "inline-editing",
    "cms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "bun test src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
