{
  "name": "@payload-onpage/core",
  "version": "0.4.1",
  "description": "payload-onpage core: document refs, schema, field operations, stega codec, autosave and the editor session, plus the port interfaces adapters implement.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-onpage.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jellologic/payload-onpage#readme",
  "bugs": "https://github.com/jellologic/payload-onpage/issues",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "payload-plugin",
    "nextjs",
    "next.js",
    "app-router",
    "tanstack",
    "tanstack-start",
    "typescript",
    "visual-editing",
    "visual-editor",
    "inline-editing",
    "front-end-editing",
    "live-preview",
    "draft-preview",
    "preview-links",
    "page-builder",
    "wysiwyg",
    "headless-cms",
    "cms",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "default": "./dist/payload.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "bun test src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
