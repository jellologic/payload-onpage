{
  "name": "payload-onpage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "tsc -b packages/core packages/plugin packages/react packages/lexical packages/next",
    "typecheck": "bun run build",
    "test": "bun run build && bun test packages",
    "clean": "rm -rf packages/*/dist",
    "dev:example": "bun run build && cd examples/basic && bun run dev"
  },
  "devDependencies": {
    "@lexical/list": "0.41.0",
    "@lexical/react": "0.41.0",
    "@lexical/rich-text": "0.41.0",
    "@lexical/selection": "0.41.0",
    "@lexical/utils": "0.41.0",
    "@payloadcms/ui": "3.87.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.14.5",
    "lexical": "0.41.0",
    "next": "16.3.0",
    "payload": "3.87.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^6.0.3"
  }
}
