{
  "name": "payload-onpage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run clean && tsc -b packages/core packages/plugin packages/react packages/lexical packages/next packages/tanstack-start",
    "clean": "rm -rf packages/*/dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run coverage && bun run build && bun run size",
    "dev:example": "bun run build && cd examples/basic && bun run dev",
    "dev:example-tanstack": "bun run build && cd examples/tanstack && bun run dev",
    "size": "size-limit",
    "e2e": "bun run build && playwright test -c e2e/playwright.config.ts",
    "e2e:tanstack": "bun run build && ONPAGE_EXAMPLE=tanstack playwright test -c e2e/playwright.config.ts",
    "e2e:all": "bun run e2e && bun run e2e:tanstack",
    "docs:api": "typedoc",
    "docs:llms": "node scripts/llms-full.mjs",
    "docs:media": "bun run build && node scripts/docs-media.mjs",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@lexical/list": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@playwright/test": "^1.64.0",
    "@size-limit/esbuild": "^11",
    "@size-limit/file": "^11",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "graphql": "^16",
    "happy-dom": "^20.14.5",
    "lexical": "0.50.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "size-limit": "^11",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
