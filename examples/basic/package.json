    "@payload-onpage/react": "workspace:*",
    "@payloadcms/db-sqlite": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "graphql": "^16.10.0",
    "next": "16.3.0",
    "payload": "3.87.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^7.0.3",
    "typescript": "^6.0.3"
