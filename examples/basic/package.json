{
  "name": "payload-onpage-example-basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
